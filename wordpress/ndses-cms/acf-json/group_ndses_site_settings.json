        { "key": "field_ndses_social_label", "label": "Label", "name": "label", "type": "text" },
        { "key": "field_ndses_social_href", "label": "URL", "name": "href", "type": "url" }
      ]
    }
  ],
  "location": [
    [
      {
        "param": "options_page",
        "operator": "==",
        "value": "ndses-site-settings"
      }
    ]
