    { "key": "field_ndses_footer_description", "label": "Footer Description", "name": "footer_description", "type": "textarea" },
    { "key": "field_ndses_copyright_text", "label": "Copyright Text", "name": "copyright_text", "type": "text" },
    {
      "key": "field_ndses_social_links",
      "label": "Social Links",
      "name": "social_links",
