      "label": "Office Hours",
      "name": "hours",
      "type": "repeater",
      "sub_fields": [
        { "key": "field_ndses_hours_line", "label": "Line", "name": "line", "type": "text" }
      ]
    },
    { "key": "field_ndses_service_area", "label": "Service Area Summary", "name": "service_area", "type": "textarea" },
    { "key": "field_ndses_facebook", "label": "Facebook URL", "name": "facebook", "type": "url", "instructions": "TODO: Facebook - Add final page URL and future alert sync settings." },
    { "key": "field_ndses_instagram", "label": "Instagram URL", "name": "instagram", "type": "url" },
    { "key": "field_ndses_header_logo", "label": "Header Logo", "name": "header_logo", "type": "image", "return_format": "array" },
