{
  "key": "group_ndses_site_settings",
  "title": "NDSES Site Settings",
  "fields": [
    { "key": "field_ndses_company_name", "label": "Company Name", "name": "company_name", "type": "text" },
    { "key": "field_ndses_legal_name", "label": "Legal Name", "name": "legal_name", "type": "text" },
    { "key": "field_ndses_phone", "label": "Phone", "name": "phone", "type": "text" },
    { "key": "field_ndses_email", "label": "Email", "name": "email", "type": "email" },
    { "key": "field_ndses_address", "label": "Facility Address", "name": "address", "type": "textarea" },
    { "key": "field_ndses_mailing_address", "label": "Mailing Address", "name": "mailing_address", "type": "textarea" },
    {
